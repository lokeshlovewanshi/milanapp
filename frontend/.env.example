# Backend base URL (no trailing slash).
# Android emulator -> http://10.0.2.2:8080
# Device over USB  -> http://localhost:8080  (after: adb reverse tcp:8080 tcp:8080)
# Device over WiFi -> http://<your-lan-ip>:8080
EXPO_PUBLIC_BACKEND_URL=http://10.0.2.2:8080

# Google Sign-In OAuth client IDs (from Google Cloud Console > Credentials).
# These are public identifiers, NOT secrets - safe to ship in the app.
# NOTE: EXPO_PUBLIC_* vars are inlined at BUILD time, so rebuild after changing.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
