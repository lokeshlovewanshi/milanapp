# ---------------------------------------------------------------------------
# Production environment for the Gahoi Milan API.
#
# Deliberately tiny. Every credential now lives in AWS Secrets Manager and is
# fetched at startup with the EC2 instance role - see
# SecretsManagerEnvironmentPostProcessor. Nothing sensitive belongs in this
# file any more.
#
# Install as /etc/gahoi-milan/gahoi-milan.env:
#   sudo install -d -m 750 -o root -g gahoi /etc/gahoi-milan
#   sudo chown root:gahoi /etc/gahoi-milan/gahoi-milan.env
#   sudo chmod 640 /etc/gahoi-milan/gahoi-milan.env
#
# systemd reads this directly: no quotes, no `export`.
# ---------------------------------------------------------------------------

# Which secret to read. Point a staging box at a different one by changing
# only this line.
SECRET_ID=gahoi-milan/prod
AWS_REGION=ap-south-1
SERVER_PORT=8080

# ---------------------------------------------------------------------------
# Emergency overrides
#
# Anything set here beats the value in Secrets Manager, because the secret is
# added as the lowest-precedence property source. Useful for changing one
# setting during an incident without editing the secret. Remove it afterwards -
# a stale override here is invisible from the console and very confusing.
#
# DB_PASSWORD=
# FIREBASE_ENABLED=false
#
# The Firebase service-account JSON is in the secret as
# FIREBASE_SERVICE_ACCOUNT_JSON. No credentials file on this disk.
# ---------------------------------------------------------------------------
