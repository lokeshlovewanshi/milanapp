# Lovewanshi Milan - Environment Variables Template
# Copy this file to .env and fill in your actual values.
# NEVER commit the real .env to git.

# Database
DB_HOST=10.30.2.230
DB_PORT=3306
DB_NAME=marriage_portal
DB_USERNAME=your_db_user
DB_PASSWORD=your_db_password
DB_LOCAL_PORT=3308
DB_URL=jdbc:mysql://127.0.0.1:3308/marriage_portal?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=Asia/Kolkata

# Server & VM
VM_IP=your_vm_public_ip
SSH_KEY=~/.ssh/oci_dev
SERVER_PORT=8080
API_BASE_URL=http://localhost:8080

# Security
JWT_SECRET=your_jwt_secret_min_32_chars
JWT_EXPIRATION=15552000000
NOTIFICATIONS_ADMIN_SECRET=your_admin_secret

# AWS S3 & Lambdas
AWS_REGION=ap-south-1
AWS_S3_BUCKET=lovewanshi-milan-photos
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
KUNDALI_ENABLED=true
KUNDALI_FUNCTION_NAME=lovewanshi-milan-dev-kundali
KUNDALI_MATCH_FUNCTION_NAME=lovewanshi-milan-dev-kundali-match
WELCOME_EMAIL_ENABLED=true
WELCOME_EMAIL_FUNCTION_NAME=lovewanshi-milan-dev-welcome-email

# Email SMTP
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_email_app_password
MAIL_FROM=your_email@gmail.com
MAIL_FROM_NAME=Lovewanshi Parinay

# Google OAuth 2.0
GOOGLE_OAUTH_CLIENT_ID=your_client_id.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_IDS=your_client_id.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=your_client_secret

# Support
SUPPORT_CONTACT_PHONE=7676554631
SUPPORT_CONTACT_EMAIL=support@example.com

