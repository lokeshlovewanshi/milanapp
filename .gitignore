# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# IDE and editors
.idea/
.vscode/

# Dependencies
node_modules/
/node_modules
/.pnp
.pnp.js
.yarn/install-state.gz
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Testing
/coverage

# Next.js
/.next/
/out/
next-env.d.ts
*.tsbuildinfo

# Production builds
/build
dist/
dist

# Environment files (comprehensive coverage)

*token.json*
*credentials.json*

# Logs and debug files
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
dump.rdb

# System files
.DS_Store
*.pem

# Python
__pycache__/
*pyc*
venv/
.venv/

# Development tools
chainlit.md
.chainlit
.ipynb_checkpoints/
.ac

# Deployment
.vercel

# Data and databases
agenthub/agents/youtube/db

# Archive files and large assets
**/*.zip
**/*.tar.gz
**/*.tar
**/*.tgz
*.pack
*.deb
*.dylib

# Build caches
.cache/

# Mobile development
android-sdk/

# Environment and credential files.
# Deliberately NOT `*.env.*` - that pattern also matched Spring's
# org.springframework.boot.env.EnvironmentPostProcessor.imports and silently
# kept the Secrets Manager loader out of every CI build.
.env
.env.*
*.env
credentials.json
*.pem
*.key
.credentials

# Backend / Java
target/
*.jar
*.war
*.ear
.idea/
*.iml
.mvn/
mvnw
mvnw.cmd


# Firebase service-account keys - these grant full send access to your FCM
# project. Never commit them.
**/firebase-service-account*.json
**/serviceAccountKey*.json

# ---------------------------------------------------------------------------
# Added while cleaning up the first push.
# ---------------------------------------------------------------------------

# Live credentials. Copy application.properties.example and fill it in locally;
# the filled-in file must never be committed.
**/src/main/resources/application.properties
*firebase-service-account*.json

# Firebase client config. The keys inside ship in the APK so they are not
# strictly secret, but there is no reason to publish the project's identifiers.
**/google-services.json
**/GoogleService-Info.plist

# Cloudflare Tunnel config for local dev (LOCAL_DEV.md). Holds a per-machine
# tunnel ID and a local credentials-file path once filled in from the
# .example template - not secret, just not anyone else's business.
**/deploy/local/cloudflared-config.yml

# Generated by `expo prebuild` - regenerate rather than commit. Also keeps
# debug.keystore and the 455 MB of build output out of the repo.
frontend/android/
frontend/ios/

# Gradle/Java build output
**/build/
**/.gradle/
**/bin/
*.class
*.jar
!**/gradle/wrapper/gradle-wrapper.jar

# Metro's transform cache. 4,400 files that churn on every save.
**/.metro-cache/

# Local recovery scratch
_recovered/

# Database dumps may contain real member data
Dump*.sql
sql/backup_*.sql

# Templates carry no secrets and must be committed - the real .env files they
# describe are still ignored by the rules above.
!**/*.env.example
!**/.env.example

# ---------------------------------------------------------------------------
# Terraform state and variables.
#
# State is NOT a build artefact - it records every attribute of every resource,
# including ones marked `sensitive`, in plaintext. This repo is public: the
# oracle state holds the HeatWave admin password and secrets.auto.tfvars holds
# the RDS one. Neither may ever be committed.
# ---------------------------------------------------------------------------
*.tfstate
*.tfstate.*
*.tfvars
!*.tfvars.example
.terraform/
tfplan*
crash.log

# Signed app binaries. 34 MB and 17 MB, rebuilt from source by EAS or gradle -
# git is the wrong place for them.
*.apk
*.aab

# Claude Code's local session state, including scratch worktrees.
.claude/
